programa
{
	
	funcao inicio()
	{
          real M //----> metros
          real Cm //----> centimetros

		escreva("Digite o valor em metros: ")
		leia(M)

		Cm=M*100

          escreva("O resultado do valor em metros em CM é: \n")
		escreva(M, " metros equivalem a ", Cm, " centímetros.\n")
	}
}
